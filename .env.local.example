# Copia este archivo como ".env.local" (en local) y pega estos mismos
# nombres/valores en Vercel -> Settings -> Environment Variables.
# Los valores se obtienen en Firebase Console -> Configuración del proyecto -> tus apps -> SDK setup.
# Este proyecto NO usa Firebase Storage, así que no necesitas el plan Blaze ni tarjeta.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# La URL pública real de tu app en Vercel (tu dominio principal, NUNCA
# una URL de preview tipo -git-main- o con un hash raro). Sin esto, el
# QR podría generarse con una URL protegida por el login de Vercel.
NEXT_PUBLIC_APP_URL=https://tu-dominio.vercel.app

# Solo si más adelante activas notificaciones push (requiere plan Blaze, opcional)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
